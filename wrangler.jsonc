{
  "name": "kotodama-a1rsms01",
  "main": "dist/worker.js",
  "compatibility_date": "2025-03-17",
  "vars": {
    "APP_CAPABILITIES": "[\"submitSafetyReport\",\"assessRisk\",\"recordIosaFinding\"]",
    "APP_DESCRIPTION": "air-sms — airline safety management system. Handles safety reports, risk assessment, IOSA findings, regulatory reports, occurrence reporting, safety bulletins, dangerous goods screening, and security alerts.",
    "APP_DISPLAY_NAME": "Air Safety Management",
    "APP_FRAMEWORK": "cljs-esm-worker",
    "APP_NANOID": "a1rsms01",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "a1rsms01.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "air-sms.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
